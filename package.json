{
  "name": "jib-be-jib-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute jib-be-jib-db --local --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute jib-be-jib-db --local --file=./src/db/seed.sql",
    "db:migrate:prod": "wrangler d1 migrations apply jib-be-jib-db --remote",
    "db:init:prod": "wrangler d1 migrations apply jib-be-jib-db --remote",
    "db:seed:prod": "wrangler d1 execute jib-be-jib-db --remote --file=./src/db/seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "hono": "^4.2.7",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.50.0"
  }
}
